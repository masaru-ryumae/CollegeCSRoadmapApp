# Supabase Configuration
# Get these values from your Supabase project at https://supabase.com/dashboard

# Your Supabase project URL
# Example: https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous (public) key
# This key is safe to expose in the frontend
# Get from Settings > API in your Supabase dashboard
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OAuth Redirect URL
# For development: http://localhost:5173
# For production: https://your-domain.com
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# Application Configuration
VITE_APP_NAME=College CS Roadmap
VITE_APP_ENV=development

# Optional: Google OAuth Configuration (if using custom OAuth setup)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
