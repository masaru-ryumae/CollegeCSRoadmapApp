# API Server Configuration
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Database (Future: Production setup)
# DATABASE_URL=postgresql://user:password@localhost:5432/summerbuilder
# REDIS_URL=redis://localhost:6379

# OAuth Providers
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/auth/github/callback

# Slack Integration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_REDIRECT_URI=http://localhost:3001/api/v1/integrations/slack/callback
SLACK_COMMUNITY_CHANNEL=general

# Discord Integration
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id

# LinkedIn Integration
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/integrations/linkedin/callback

# Twitter/X Integration
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Facebook Integration
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_TOKEN=your-facebook-page-token

# URL Shortener
BITLY_TOKEN=your-bitly-token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_FREE=1000
RATE_LIMIT_MAX_PREMIUM=5000
RATE_LIMIT_MAX_ENTERPRISE=10000

# Valid API Keys (comma-separated for demo)
VALID_API_KEYS=demo-key-1,demo-key-2

# Email Configuration (for future email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/api.log

# Analytics (Optional)
SENTRY_DSN=your-sentry-dsn
MIXPANEL_TOKEN=your-mixpanel-token

# Feature Flags
ENABLE_SOCIAL_SHARING=true
ENABLE_SLACK_INTEGRATION=true
ENABLE_DISCORD_INTEGRATION=true
ENABLE_LINKEDIN_INTEGRATION=true
