# Environment Configuration Template for College CS Roadmap App
# Copy this file to .env.local and fill in the values
#
# This template documents all required environment variables for the application
# to function across web and mobile platforms.

# ============================================================================
# API & Backend Configuration
# ============================================================================

# Base URL for the backend API server
# Where: Backend server (Node.js/Express, Firebase Functions, or Supabase)
# Example: http://localhost:3000 (dev) or https://api.roadmapapp.com (prod)
VITE_API_BASE_URL=http://localhost:3000

# Backend authentication endpoint for token refresh
# Where: Backend API /auth/refresh endpoint
VITE_AUTH_REFRESH_URL=http://localhost:3000/auth/refresh

# ============================================================================
# Authentication (OAuth & Session)
# ============================================================================

# Auth0 Configuration
# Where: Auth0 dashboard → Applications → Your App → Settings
VITE_AUTH0_DOMAIN=your-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
VITE_AUTH0_AUDIENCE=https://roadmapapi.example.com

# Firebase Authentication (Alternative to Auth0)
# Where: Firebase Console → Project Settings → Service Accounts
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Session Configuration
# Expiration time in minutes
VITE_SESSION_TIMEOUT_MINUTES=60

# ============================================================================
# Supabase Configuration (Backend + Database)
# ============================================================================

# Where: Supabase Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# Notifications & Email Service
# ============================================================================

# Email Service Configuration
# Where: SendGrid Console → API Keys or Mailgun Dashboard → API Keys
VITE_NOTIFICATION_SERVICE_URL=https://notification-service.example.com
VITE_NOTIFICATION_API_KEY=your_notification_api_key

# In-app Notification Settings
VITE_NOTIFICATION_TOAST_DURATION_MS=5000
VITE_NOTIFICATION_MAX_QUEUE=5

# ============================================================================
# Feature Flags & Configuration
# ============================================================================

# Enable/disable features
VITE_ENABLE_PROGRESS_SYNC=true
VITE_ENABLE_ADMIN_DASHBOARD=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_DARK_MODE=true

# ============================================================================
# Mobile App Specific
# ============================================================================

# Expo Configuration (for React Native)
# Where: app.json in mobile app directory
VITE_MOBILE_APP_IDENTIFIER=com.roadmapapp.student
VITE_MOBILE_APP_VERSION=1.0.0

# Deep linking configuration
VITE_DEEP_LINK_SCHEME=roadmapapp://

# ============================================================================
# Analytics & Monitoring
# ============================================================================

# Google Analytics
# Where: Google Analytics Console → Property Settings → Measurement ID
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
# Where: Sentry Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456

# ============================================================================
# Development Settings
# ============================================================================

# Logging level: 'debug' | 'info' | 'warn' | 'error'
VITE_LOG_LEVEL=debug

# Enable debug mode (shows additional UI info, verbose console logs)
VITE_DEBUG_MODE=false

# ============================================================================
# API Endpoints (Auto-generated from API_BASE_URL, shown for reference)
# ============================================================================

# These are derived from VITE_API_BASE_URL, documented for reference:
# GET    /api/modules                    - List all modules
# POST   /api/modules                    - Create module (admin only)
# PUT    /api/modules/:id                - Update module (admin only)
# DELETE /api/modules/:id                - Delete module (admin only)
# POST   /api/roadmaps                   - Generate personalized roadmap
# GET    /api/roadmaps/:id               - Get user's roadmap
# PUT    /api/roadmaps/:id/progress      - Update progress on module
# POST   /api/notifications              - Send notification
# GET    /api/notifications              - List user notifications
# PUT    /api/notifications/:id/read     - Mark notification as read
# POST   /auth/login                     - Login with OAuth
# POST   /auth/logout                    - Logout (invalidate token)
# POST   /auth/refresh                   - Refresh auth token

# ============================================================================
# Notes
# ============================================================================

# 1. This file should NOT be committed to version control
#    Git ignores: .env.local, .env.*.local, .env
#
# 2. For production, create a separate deployment process to inject these vars
#    (e.g., GitHub Actions secrets, Vercel environment variables, etc.)
#
# 3. Mobile app (.env file) and web app (.env.local) can have different values
#    Example: different API endpoints for staging vs production
#
# 4. VITE_ prefix is required for all variables to be accessible in the React app
#    They are inlined at build time (not sent from server)
#
# 5. Sensitive keys (API keys, secrets) should NEVER be committed
#    Use a secrets management tool (1Password, LastPass, etc.) for team access
#
# 6. For local development:
#    - Copy this template to .env.local
#    - Fill in localhost URLs
#    - Use dummy values for external services (auth, notifications)
#    - Use real values only if you have access to those services
#
# 7. CI/CD deployment:
#    - Use GitHub Actions/Vercel secrets to inject env vars at build time
#    - Do NOT store .env files in version control
