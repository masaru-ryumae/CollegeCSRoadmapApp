# Environment Configuration Template for College CS Roadmap App (Mobile)
# Copy this file to roadmap-mobile/.env and fill in the values
#
# Mobile app (React Native / Expo) uses the same environment variables as web,
# but they are configured differently in app.json and in the app initialization

# ============================================================================
# API & Backend Configuration (Same as web)
# ============================================================================

# Base URL for the backend API server
# Where: Backend server (Node.js/Express, Firebase Functions, or Supabase)
# Note: Can differ from web (e.g., different staging/production endpoints)
REACT_APP_API_BASE_URL=http://localhost:3000

# Backend authentication endpoint for token refresh
REACT_APP_AUTH_REFRESH_URL=http://localhost:3000/auth/refresh

# ============================================================================
# Authentication (OAuth & Session)
# ============================================================================

# Auth0 Configuration
# Where: Auth0 dashboard → Applications → Mobile (Native) App → Settings
REACT_APP_AUTH0_DOMAIN=your-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your_mobile_client_id
REACT_APP_AUTH0_AUDIENCE=https://roadmapapi.example.com

# Note: For iOS, also configure:
# - iOS Custom Scheme: com.roadmapapp://localhost
# - iOS Universal Links: entitlements in app signing

# Note: For Android, also configure:
# - Android Package Name: com.roadmapapp
# - Android SHA256 Certificate Fingerprint (for Google OAuth)

# Firebase Authentication (Alternative to Auth0)
# Where: Firebase Console → Project Settings → Service Accounts
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:android:abcdef123456

# Session Configuration
REACT_APP_SESSION_TIMEOUT_MINUTES=60

# ============================================================================
# Supabase Configuration (Backend + Database)
# ============================================================================

# Where: Supabase Project Settings → API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# Notifications & Push Service
# ============================================================================

# Firebase Cloud Messaging (for push notifications)
# Where: Firebase Console → Cloud Messaging → Server API Key
REACT_APP_FCM_SERVER_KEY=your_fcm_server_key

# Email Service Configuration
REACT_APP_NOTIFICATION_SERVICE_URL=https://notification-service.example.com
REACT_APP_NOTIFICATION_API_KEY=your_notification_api_key

# In-app Notification Settings
REACT_APP_NOTIFICATION_TOAST_DURATION_MS=5000
REACT_APP_NOTIFICATION_MAX_QUEUE=5

# ============================================================================
# Feature Flags & Configuration
# ============================================================================

# Enable/disable features
REACT_APP_ENABLE_PROGRESS_SYNC=true
REACT_APP_ENABLE_ADMIN_DASHBOARD=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_BIOMETRIC_AUTH=true

# ============================================================================
# Mobile App Specific Configuration
# ============================================================================

# Expo Project Configuration
# Where: app.json in mobile app directory (also set there)
REACT_APP_EXPO_OWNER=your_expo_username
REACT_APP_EXPO_SLUG=roadmap-mobile
REACT_APP_EXPO_VERSION=1.0.0
REACT_APP_EXPO_BUILD_NUMBER=1

# iOS Configuration
# Bundle identifier: com.roadmapapp.student
REACT_APP_IOS_BUNDLE_ID=com.roadmapapp.student
REACT_APP_IOS_SCHEME_URL=roadmapapp://

# Android Configuration
# Package name: com.roadmapapp
REACT_APP_ANDROID_PACKAGE=com.roadmapapp
REACT_APP_ANDROID_SCHEME_URL=roadmapapp://

# Deep Linking Configuration
# Handles: roadmapapp://dashboard, roadmapapp://roadmap/:id, etc.
REACT_APP_DEEP_LINK_PREFIX=roadmapapp://

# ============================================================================
# Analytics & Monitoring
# ============================================================================

# Google Analytics (for mobile)
# Where: Firebase Console → Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry (Error Tracking, works for mobile)
# Where: Sentry Project → Settings → Client Keys (DSN)
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456

# ============================================================================
# Development & Debugging Settings
# ============================================================================

# Logging level: 'debug' | 'info' | 'warn' | 'error'
REACT_APP_LOG_LEVEL=debug

# Enable debug mode (shows additional UI info, verbose console logs)
REACT_APP_DEBUG_MODE=false

# Expo Development Client Configuration
# Set to 'true' for development builds, 'false' for production
REACT_APP_EXPO_DEV_CLIENT=true

# ============================================================================
# Storage Configuration (Mobile Specific)
# ============================================================================

# AsyncStorage prefix for persisted data
REACT_APP_STORAGE_PREFIX=@roadmapapp/

# Maximum storage cache (bytes)
REACT_APP_STORAGE_MAX_SIZE=5242880

# ============================================================================
# Network Configuration (Mobile Specific)
# ============================================================================

# Network request timeout (milliseconds)
REACT_APP_NETWORK_TIMEOUT_MS=30000

# Enable network debugging (LogBox warnings for network requests)
REACT_APP_NETWORK_DEBUG=false

# ============================================================================
# Platform-Specific Differences
# ============================================================================

# Note: Web app uses VITE_ prefix
#       Mobile app uses REACT_APP_ prefix
#
# Both are loaded at compile/build time, NOT from environment variables at runtime
#
# For Expo, these can also be configured in:
# - app.json (extra.apiBaseUrl, etc.)
# - eas.json (for cloud builds)
#
# Example mapping:
# VITE_API_BASE_URL (web)           → REACT_APP_API_BASE_URL (mobile)
# VITE_AUTH0_DOMAIN (web)           → REACT_APP_AUTH0_DOMAIN (mobile)
# VITE_FIREBASE_API_KEY (web)       → REACT_APP_FIREBASE_API_KEY (mobile)
# VITE_SUPABASE_URL (web)           → REACT_APP_SUPABASE_URL (mobile)

# ============================================================================
# Quick Start Guide
# ============================================================================

# 1. Copy this file:
#    cp .env.mobile.template ../roadmap-mobile/.env
#
# 2. Fill in the values (same as web, but REACT_APP_ prefix):
#    sed -i 's/REACT_APP_/REACT_APP_/g' ../roadmap-mobile/.env
#
# 3. For development, use:
#    cd ../roadmap-mobile
#    expo start
#
# 4. For building APK/IPA, use:
#    eas build --platform android
#    eas build --platform ios
#
# 5. All REACT_APP_ variables are available as:
#    import { Platform } from 'react-native';
#    const API_BASE_URL = process.env.REACT_APP_API_BASE_URL;

# ============================================================================
# Security Notes
# ============================================================================

# 1. NEVER commit .env files to Git
# 2. Use Expo EAS secrets for cloud builds: eas secret:create
# 3. Client-side secrets (REACT_APP_*) are baked into the APK/IPA
#    - Do NOT use backend API keys (use session tokens instead)
# 4. Store sensitive data (auth tokens) in secure storage:
#    - iOS: Keychain (expo-secure-store)
#    - Android: EncryptedSharedPreferences (expo-secure-store)
